[user]
	email = b.anshuman1305@gmail.com
	name = ba-13
[init]
	defaultBranch = main
[safe]
[core]
	autocrlf = false
	editor = vim
	fileMode = false
[credential]
	helper = store
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
