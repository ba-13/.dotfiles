# Global properties
separator=true
separator_block_width=24
markup=pango

# Left outer border spacer
[left_border]
full_text= 
interval=once

# 1. CPU Usage (Blue -> Peach -> Red)
[cpu]
label= 
command=top -bn1 | grep "Cpu(s)" | awk '{u=$2+$4; c=(u>=80)?"#f38ba8":(u>=50)?"#fab387":"#89b4fa"; printf "%.0f%%\n%.0f%%\n%s\n", u, u, c}'
interval=5

# 2. RAM Usage (Teal -> Peach -> Red)
[memory]
label= 
command=free -m | awk '/^Mem:/ {p=($3/$2)*100; u=sprintf("%.1fGi/%.0fGi", $3/1024, $2/1024); c=(p>=85)?"#f38ba8":(p>=65)?"#fab387":"#94e2d5"; printf "%s\n%s\n%s\n", u, u, c}'
interval=10

# 3. Home Disk Space (Green -> Peach -> Red)
[disk]
label= 
command=df -h /home | awk 'NR==2 {gsub(/%/,"",$5); p=$5+0; c=(p>=90)?"#f38ba8":(p>=75)?"#fab387":"#a6e3a1"; printf "%s\n%s\n%s\n", $4, $4, c}'
interval=60

# 4. Wi-Fi / Ethernet Status (Left-click: nmtui, Right-click: nm-connection-editor)
[network]
command=case "$BLOCK_BUTTON" in 1) setsid -f i3-sensible-terminal -e nmtui >/dev/null 2>&1 ;; 3) setsid -f nm-connection-editor >/dev/null 2>&1 ;; esac; ip route get 1.1.1.1 2>/dev/null | grep -q "dev w" && echo " $(iwgetid -r)" || (ip route get 1.1.1.1 2>/dev/null | grep -q "dev e" && echo " Wired" || echo " Offline")
interval=10
color=#74c7ec

# 5. Brightness (Scroll up/down: +/-5% brightness)
[brightness]
label= 
command=case "$BLOCK_BUTTON" in 4) brightnessctl set +5% >/dev/null ;; 5) brightnessctl set 5%- >/dev/null ;; esac; brightnessctl -m | cut -d, -f4
interval=once
signal=11
color=#f9e2af

# 6. Volume (Left-click: pavucontrol, Right-click: Mute, Scroll: +/-5%)
[volume]
label= 
command=case "$BLOCK_BUTTON" in 1) setsid -f pavucontrol >/dev/null 2>&1 ;; 3) pactl set-sink-mute @DEFAULT_SINK@ toggle >/dev/null ;; 4) pactl set-sink-volume @DEFAULT_SINK@ +5% >/dev/null ;; 5) pactl set-sink-volume @DEFAULT_SINK@ -5% >/dev/null ;; esac; pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q "yes" && echo "Muted" || (pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -1 || amixer sget Master | grep -o '[0-9]*%' | head -1)
interval=5
signal=10
color=#fab387

# 7. Battery
[battery]
label= 
command=cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1 | sed 's/$/%/'
interval=30
color=#f2cdcd

# 8. Date
[date]
label= 
command=date '+%a %d %b'
interval=60
color=#cba6f7

# 9. Time with Seconds
[time]
label= 
command=date '+%H:%M:%S'
interval=1
color=#f5c2e7

# Right outer border spacer
[right_border]
full_text= 
interval=once

